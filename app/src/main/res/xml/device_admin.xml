<?xml version="1.0" encoding="utf-8"?>
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <!-- Base mode: lock the device from our own lock screen -->
        <lock-screen />
        <!-- Strong mode (device owner only): disable the system keyguard -->
        <disable-keyguard />
        <!-- Strong mode: stop the app being uninstalled while locked -->
        <limit-password />
    </uses-policies>
</device-admin>